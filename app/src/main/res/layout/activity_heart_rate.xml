<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/primary_dark">

    <!-- Section 1: Last Exported Timestamp and Cloud Name -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last Exported to Cloud"
                android:textSize="18sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_cloud"
                android:drawablePadding="8dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/lastExportedTimestampTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Timestamp: N/A"
                android:textSize="16sp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/cloudNameTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cloud: N/A"
                android:textSize="16sp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Section 2: MQTT Settings -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MQTT Settings"
                android:textSize="18sp"
                android:textStyle="bold"
                android:drawableStart="@drawable/ic_language"
                android:drawablePadding="8dp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/mqttBrokerAddressEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Broker Address"
                android:textSize="16sp"
                android:inputType="text"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/mqttBrokerPortEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Broker Port (default: 1883)"
                android:textSize="16sp"
                android:inputType="number"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/mqttLoginEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="MQTT Login"
                android:textSize="16sp"
                android:inputType="text"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/mqttPasswordEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="MQTT Password"
                android:textSize="16sp"
                android:inputType="textPassword"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/saveMqttSettingsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Save MQTT Settings"
                android:textSize="16sp"
                android:backgroundTint="@color/alternate_row_background_dark"
                android:textColor="@color/accent"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/connectionStatusTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Disconnected\nServer: -\nPort: -"
                android:textSize="16sp"
                android:drawableStart="@drawable/ic_add"
                android:drawablePadding="8dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>